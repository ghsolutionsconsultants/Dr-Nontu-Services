# Copy to .env.local (dev) or set in Vercel (production)
NEXT_PUBLIC_SITE_URL=https://www.drnontu.co.za
SESSION_SECRET=                       # 32+ random bytes
DATABASE_URL=                         # Supabase → Project settings → Database → connection string (pooler, port 6543). Empty = local PGlite
DB_AUTO_MIGRATE=                      # set to 1 to run schema + seed on boot against DATABASE_URL
ADMIN_EMAIL=                          # first admin account, created if none exists
ADMIN_PASSWORD=
PAYSTACK_SECRET_KEY=                  # sk_test_… / sk_live_…  Empty = built-in test checkout
RESEND_API_KEY=                       # empty = emails kept in the outbox table only
MAIL_FROM=Dr Nontu Medical Practice <bookings@drnontu.co.za>
CRON_SECRET=                          # Vercel Cron bearer token for /api/cron/*
